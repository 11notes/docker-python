#!/bin/sh
  if echo "${1}" | grep -q "github.com"; then
    # check if package comes from github
    rm -rf ${WHEEL_BUILD}
    if [ ! -z ${2} ]; then
      # check if we need to build a branch
      BRANCH=$(echo ${2} | sed 's|^v||')
      if git clone --recurse-submodules ${1} -b ${BRANCH} ${WHEEL_BUILD}; then
        eleven log info "using github repo ${1} ${BRANCH}"
        wheel-build-git ${BRANCH} || exit 1
      else
        eleven log error "git clone --recurse-submodules ${1} -b ${BRANCH} ${WHEEL_BUILD} failed!"
        # check if branch has a branch suffix with v present
        if git clone --recurse-submodules ${1} -b v${BRANCH} ${WHEEL_BUILD}; then
          eleven log info "using github repo ${1} v${BRANCH}"
          wheel-build-git ${BRANCH} || exit 1
        else
          eleven log error "git clone --recurse-submodules ${1} -b v${BRANCH} ${WHEEL_BUILD} failed!"
          exit 1
        fi
      fi
    else
      if git clone --recurse-submodules ${1} ${WHEEL_BUILD}; then
        eleven log info "using github repo ${1}"
        wheel-build-git || exit 1
      else
        eleven log error "git clone --recurse-submodules ${1} ${WHEEL_BUILD} failed!"
        exit 1
      fi
    fi
  else
    if [ -d "${1}" ]; then
      WHEEL_BUILD="${1}" wheel-build-git "${2}" || exit 1
    else
      pip wheel \
        --wheel-dir ${WHEEL_BUILD_TMP} \
        --cache-dir ${WHEEL_BUILD_TMP} \
        ${1}==$(echo ${2} | sed 's|v||g')
      wheel-build-find pip ${1} || exit 1
    fi
  fi